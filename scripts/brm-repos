#!/usr/bin/env python3
"""BRM multi-repo CLI.

Eight subcommands:
  init [--from-pf] [--force]
  list [--json]
  topology [--json]
  describe NAME [--json]
  owns PATH
  status [--brief] [--json]
  snapshot [--label LABEL]
  branch NAME [--repos all|csv]
"""
from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
PLUGIN_ROOT = SCRIPT_DIR.parent
sys.path.insert(0, str(PLUGIN_ROOT))

from lib import orchestrator as _orch  # noqa: E402


STARTER_YAML = """\
# BRM repos config — see docs/orchestrator-schema.md
repos:
  example:
    path: example
    type: lib
    description: Replace with your repos
    default_branch: main
    test_command: ""
    lint_command: ""
    build_command: ""
"""


def _resolve_orchestrator_root(cwd: Path) -> Path | None:
    override = os.environ.get("BRM_ORCHESTRATOR_ROOT")
    if override:
        candidate = Path(override)
        if (candidate / ".brm" / "repos.yaml").is_file():
            return candidate
        return None
    return _orch.find_orchestrator_root(cwd)


def _die(msg: str, code: int = 1) -> None:
    print(f"brm-repos: {msg}", file=sys.stderr)
    sys.exit(code)


# --- init -----------------------------------------------------------------

def cmd_init(args: argparse.Namespace) -> int:
    cwd = Path.cwd()
    target = cwd / ".brm" / "repos.yaml"
    if target.exists() and not args.force:
        _die(f"{target} already exists; pass --force to overwrite")
    target.parent.mkdir(parents=True, exist_ok=True)

    if args.from_pf:
        pf_path = cwd / ".pennyfarthing" / "repos.yaml"
        if not pf_path.is_file():
            _die(f"no .pennyfarthing/repos.yaml found at {pf_path}")
        try:
            text = pf_path.read_text(encoding="utf-8", errors="replace")
            content, dropped = _translate_pf(text)
        except _orch.RepoConfigError as e:
            _die(f"could not parse {pf_path}: {e}")
        target.write_text(content)
        if dropped:
            print(
                f"brm-repos: dropped {len(dropped)} PF-only field(s); "
                f"see docs/orchestrator-schema.md",
                file=sys.stderr,
            )
        return 0

    target.write_text(STARTER_YAML)
    print(f"created {target}")
    return 0


_PF_ONLY_PER_REPO = {
    "owns", "never_edit", "symlinks", "ui_layer", "components_path",
    "branch_strategy", "language", "notes",
}
_PF_ONLY_TOP = {"pr_title_format", "gates"}


def _translate_pf(pf_text: str) -> tuple[str, list[str]]:
    """Translate a PF repos.yaml to BRM schema. Returns (yaml_text, dropped_fields)."""
    import yaml
    doc = yaml.safe_load(pf_text)
    if not isinstance(doc, dict) or "repos" not in doc:
        raise _orch.RepoConfigError("PF repos.yaml missing `repos` key")

    dropped: list[str] = []
    for key in list(doc.keys()):
        if key in _PF_ONLY_TOP:
            dropped.append(key)

    out_repos: dict[str, dict] = {}
    for name, raw in doc.get("repos", {}).items():
        if not isinstance(raw, dict):
            continue
        for k in list(raw.keys()):
            if k in _PF_ONLY_PER_REPO:
                dropped.append(f"repos.{name}.{k}")
        out_repos[str(name)] = {
            "path": str(raw.get("path", name)),
            "type": str(raw.get("type", "lib")),
            "description": str(raw.get("description", "")),
            "default_branch": str(raw.get("default_branch", "main")),
            "test_command": str(raw.get("test_command", "")),
            "lint_command": str(raw.get("lint_command", "")),
            "build_command": str(raw.get("build_command", "")),
        }
    return yaml.safe_dump({"repos": out_repos}, sort_keys=False), dropped


# --- list / topology / describe / owns -----------------------------------

def _require_orch_root() -> tuple[Path, dict[str, _orch.RepoConfig], str]:
    """Resolve orchestrator root, load repos.yaml. Exits 1 if not found."""
    root = _resolve_orchestrator_root(Path.cwd())
    if root is None:
        _die("not in an orchestrator workspace (no .brm/repos.yaml found)")
    text = (root / ".brm" / "repos.yaml").read_text(encoding="utf-8", errors="replace")
    try:
        repos = _orch.parse_repos_yaml(text)
    except _orch.RepoConfigError as e:
        _die(f"could not parse {root / '.brm' / 'repos.yaml'}: {e}")
    return root, repos, text


def cmd_list(args: argparse.Namespace) -> int:
    _, repos, _ = _require_orch_root()
    if args.json:
        import json as _json
        print(_json.dumps(
            [{"name": r.name, "path": r.path, "type": r.type} for r in repos.values()]
        ))
    else:
        for name in repos:
            print(name)
    return 0


def cmd_topology(args: argparse.Namespace) -> int:
    root, repos, text = _require_orch_root()
    if args.json:
        import json as _json
        print(_json.dumps({
            "root": str(root),
            "repos": {
                r.name: {
                    "path": r.path,
                    "type": r.type,
                    "description": r.description,
                    "default_branch": r.default_branch,
                    "test_command": r.test_command,
                    "lint_command": r.lint_command,
                    "build_command": r.build_command,
                }
                for r in repos.values()
            },
        }))
    else:
        sys.stdout.write(text)
    return 0


def cmd_describe(args: argparse.Namespace) -> int:
    _, repos, _ = _require_orch_root()
    if args.name not in repos:
        _die(f"unknown repo: {args.name}", code=2)
    r = repos[args.name]
    if args.json:
        import json as _json
        print(_json.dumps({
            "name": r.name, "path": r.path, "type": r.type,
            "description": r.description, "default_branch": r.default_branch,
            "test_command": r.test_command, "lint_command": r.lint_command,
            "build_command": r.build_command,
        }))
    else:
        for field in ("name", "path", "type", "description", "default_branch",
                      "test_command", "lint_command", "build_command"):
            print(f"{field}: {getattr(r, field)}")
    return 0


def cmd_owns(args: argparse.Namespace) -> int:
    root, repos, _ = _require_orch_root()
    target = Path(args.path).resolve()
    # Build (repo_abs, name) pairs, longest-path-first.
    candidates: list[tuple[Path, str]] = []
    for name, r in repos.items():
        candidates.append(((root / r.path).resolve(), name))
    candidates.sort(key=lambda p: len(str(p[0])), reverse=True)
    for repo_root, name in candidates:
        if target == repo_root or repo_root in target.parents:
            print(name)
            return 0
    _die(f"no repo owns: {args.path}", code=2)
    return 2  # unreachable


# --- status / snapshot / branch ------------------------------------------

def _git(repo_path: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo_path), *args],
        capture_output=True, text=True
    )


def cmd_status(args: argparse.Namespace) -> int:
    root, repos, _ = _require_orch_root()
    rows: list[dict] = []
    any_dirty = False
    for r in repos.values():
        repo_path = root / r.path
        if not (repo_path / ".git").exists():
            rows.append({"name": r.name, "missing": True})
            continue
        branch = _git(repo_path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        porcelain = _git(repo_path, "status", "--porcelain").stdout
        dirty = bool(porcelain.strip())
        # Unpushed: any commit on HEAD not on upstream
        upstream = _git(repo_path, "rev-parse", "--abbrev-ref", "@{u}").stdout.strip()
        unpushed = False
        if upstream:
            unpushed = bool(
                _git(repo_path, "log", "@{u}..HEAD", "--oneline").stdout.strip()
            )
        rows.append({
            "name": r.name, "branch": branch, "dirty": dirty,
            "unpushed": unpushed, "missing": False,
        })
        if dirty or unpushed:
            any_dirty = True

    if args.json:
        import json as _json
        print(_json.dumps(rows))
    elif args.brief:
        for row in rows:
            if row.get("missing"):
                print(f"{row['name']:20s} MISSING")
            else:
                flags = ("*" if row["dirty"] else " ") + ("↑" if row["unpushed"] else " ")
                print(f"{row['name']:20s} {row['branch']:24s} {flags}")
    else:
        for row in rows:
            if row.get("missing"):
                print(f"== {row['name']} (missing on disk) ==")
                continue
            print(f"== {row['name']} ({row['branch']}) ==")
            if row["dirty"]:
                print(f"  dirty: uncommitted changes")
            if row["unpushed"]:
                print(f"  unpushed: commits ahead of upstream")
            if not row["dirty"] and not row["unpushed"]:
                print("  clean")
    return 1 if any_dirty else 0


def cmd_snapshot(args: argparse.Namespace) -> int:
    root, repos, _ = _require_orch_root()
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%S")
    label = args.label or "snap"
    branch_name = f"snapshot/{ts}-{label}"
    had_dirty = False
    errors = []
    for r in repos.values():
        repo_path = root / r.path
        if not (repo_path / ".git").exists():
            continue
        if not _git(repo_path, "status", "--porcelain").stdout.strip():
            continue  # clean
        had_dirty = True
        original = _git(repo_path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
        steps = [
            ("switch", "-c", branch_name),
            ("add", "-A"),
            ("-c", "user.email=brm@local", "-c", "user.name=brm",
             "commit", "-q", "-m", f"snapshot: {label}"),
            ("switch", original),
        ]
        for s in steps:
            res = _git(repo_path, *s)
            if res.returncode != 0:
                errors.append(f"{r.name}: {' '.join(s)}: {res.stderr.strip()}")
                break
        else:
            print(f"snapshot: {r.name} → {branch_name}")
    if errors:
        for e in errors:
            print(e, file=sys.stderr)
        return 1
    if not had_dirty:
        print("snapshot: all repos clean; nothing to snapshot")
    return 0


def cmd_branch(args: argparse.Namespace) -> int:
    root, repos, _ = _require_orch_root()
    selected = _select_repos(repos, args.repos)
    errors = []
    for r in selected:
        repo_path = root / r.path
        if not (repo_path / ".git").exists():
            errors.append(f"{r.name}: missing on disk")
            continue
        # Refuse if branch already exists.
        existing = _git(repo_path, "branch", "--list", args.name).stdout.strip()
        if existing:
            errors.append(f"{r.name}: branch {args.name} already exists")
            continue
        # Best-effort fetch; ignore failures (no upstream is fine for tests).
        _git(repo_path, "fetch", "origin", r.default_branch)
        # Branch from current default_branch (or current HEAD if no origin tracking).
        base = r.default_branch
        # Prefer origin/<default> if it exists, else local <default>, else HEAD.
        ref = None
        if _git(repo_path, "rev-parse", "--verify", f"origin/{base}").returncode == 0:
            ref = f"origin/{base}"
        elif _git(repo_path, "rev-parse", "--verify", base).returncode == 0:
            ref = base
        else:
            ref = "HEAD"
        res = _git(repo_path, "switch", "-c", args.name, ref)
        if res.returncode != 0:
            errors.append(f"{r.name}: {res.stderr.strip()}")
        else:
            print(f"branch: {r.name} → {args.name} (from {ref})")
    if errors:
        for e in errors:
            print(e, file=sys.stderr)
        return 1
    return 0


def _select_repos(
    repos: dict[str, _orch.RepoConfig], spec: str
) -> list[_orch.RepoConfig]:
    if spec == "all":
        return list(repos.values())
    names = [s.strip() for s in spec.split(",") if s.strip()]
    selected = []
    for n in names:
        if n not in repos:
            _die(f"unknown repo: {n}", code=2)
        selected.append(repos[n])
    return selected


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="brm-repos", description="BRM multi-repo CLI")
    sub = p.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init", help="Create .brm/repos.yaml in cwd")
    p_init.add_argument("--from-pf", action="store_true",
                        help="Import from cwd/.pennyfarthing/repos.yaml")
    p_init.add_argument("--force", action="store_true",
                        help="Overwrite an existing repos.yaml")
    p_init.set_defaults(func=cmd_init)

    p_list = sub.add_parser("list", help="List repo short-names")
    p_list.add_argument("--json", action="store_true")
    p_list.set_defaults(func=cmd_list)

    p_top = sub.add_parser("topology", help="Print full repos.yaml content")
    p_top.add_argument("--json", action="store_true")
    p_top.set_defaults(func=cmd_topology)

    p_desc = sub.add_parser("describe", help="Print one repo's full config")
    p_desc.add_argument("name")
    p_desc.add_argument("--json", action="store_true")
    p_desc.set_defaults(func=cmd_describe)

    p_owns = sub.add_parser("owns", help="Print short-name of repo containing PATH")
    p_owns.add_argument("path")
    p_owns.set_defaults(func=cmd_owns)

    p_status = sub.add_parser("status", help="Show git status for all repos")
    p_status.add_argument("--brief", action="store_true")
    p_status.add_argument("--json", action="store_true")
    p_status.set_defaults(func=cmd_status)

    p_snap = sub.add_parser("snapshot", help="Safety branch + commit in dirty repos")
    p_snap.add_argument("--label", default="snap")
    p_snap.set_defaults(func=cmd_snapshot)

    p_branch = sub.add_parser("branch", help="Create branch across selected repos")
    p_branch.add_argument("name")
    p_branch.add_argument("--repos", default="all",
                          help="'all' or comma-separated repo names")
    p_branch.set_defaults(func=cmd_branch)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
