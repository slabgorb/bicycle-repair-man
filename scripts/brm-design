_DISPATCH = {
    "init": cmd_init, "status": cmd_status, "handoff": cmd_handoff,
    "gate": cmd_gate, "record-gate": cmd_record_gate, "advance": cmd_advance,
    "block": cmd_block, "unblock": cmd_unblock, "complete": cmd_complete,
    "abandon": cmd_abandon, "list": cmd_list, "validate": cmd_validate,
}


def main() -> int:
    parser = _build_parser()
    args = parser.parse_args()
    return _DISPATCH[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
